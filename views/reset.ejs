<%- include('partials/head') %><main class="auth-page"><% if(typeof complete!=='undefined'&&complete){ %><section class="panel auth-card"><h1>Password updated</h1><p>Return to your private team portal to sign in.</p></section><% }else if(!valid){ %><section class="panel auth-card"><h1>Link expired</h1><p>Request a new password reset link.</p></section><% }else{ %><form class="panel auth-card" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><h1>Create new password</h1><% if(typeof error!=='undefined'){ %><p class="form-error"><%= error %></p><% } %><label>New password<input type="password" name="password" minlength="12" required></label><button class="button">Update password</button></form><% } %></main><%- include('partials/footer') %>
