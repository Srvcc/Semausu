<%- include('partials/head') %>
<main data-navigation data-slug="<%= supermarket.slug %>"><div class="pagehead"><div><p class="eyebrow">LIVE SUPERMARKET MAP</p><h1><%= supermarket.name %></h1><p><%= supermarket.address %></p></div><a class="button secondary" href="/supermarket/<%= supermarket.slug %>/dashboard">Store dashboard</a></div>
<div class="navigator"><aside class="panel"><label>Start at<select id="entrance"><% map.entrances.forEach(entry => { %><option value="<%= entry.id %>"><%= entry.name %></option><% }) %></select></label><h2>Shopping list</h2><div class="menu-list"><% map.products.forEach(product => { %><label class="menu-item"><input type="checkbox" value="<%= product.id %>"><span><b><%= product.name %></b><small><%= product.category %> · R<%= product.price.toFixed(2) %> · <%= product.aisle_code %>, bay <%= product.bay %>, <%= product.shelf %></small></span></label><% }) %></div><button class="button" id="buildRoute">Build shortest route</button><ol id="routeStops"></ol></aside>
<section class="map-wrap"><svg id="storeMap" viewBox="0 0 <%= supermarket.map_width %> <%= supermarket.map_height %>"><% map.aisles.forEach(aisle => { %><g class="zone"><rect x="<%= aisle.x %>" y="<%= aisle.y %>" width="<%= aisle.width %>" height="<%= aisle.height %>" rx="18"/><text x="<%= aisle.x + aisle.width/2 %>" y="<%= aisle.y + aisle.height/2 %>"><%= aisle.code %> · <%= aisle.name %></text></g><% }) %><% map.entrances.forEach(entry => { %><circle class="entrance" cx="<%= entry.x %>" cy="<%= entry.y %>" r="12"/><% }) %><polyline id="routeLine" points=""/></svg></section></div></main>
<%- include('partials/footer') %>
