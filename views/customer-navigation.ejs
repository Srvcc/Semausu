<%- include('partials/head') %>
<main class="customer-map-page" data-navigation data-slug="<%= supermarket.slug %>" data-csrf="<%= csrf %>">
  <div class="customer-heading"><div><p class="eyebrow">SHOPPING ROUTE</p><h1><%= supermarket.name %></h1><p><%= supermarket.address %></p></div><div class="privacy-note">No login required</div></div>
  <script type="application/json" id="productData"><%- JSON.stringify(map.products).replace(/</g,'\\u003c') %></script>
  <div class="customer-layout">
    <aside class="shopping-builder">
      <section class="builder-step"><span class="step-number">1</span><div><h2>Paste your shopping list</h2><p>Use one item per line. You choose the exact brand or size before we build a route.</p></div></section>
      <textarea id="shoppingList" rows="7" placeholder="Milk&#10;Eggs&#10;Bread"></textarea>
      <button class="button full-button" id="matchList">Find matching products</button>
      <div id="matchResults" class="match-results" aria-live="polite"></div>
      <section class="selection-success" id="selectionSuccess" hidden><span>✓</span><div><h3>Products added successfully</h3><p>Your choices are ready. Add any missing items above, or build the shortest route now.</p></div></section>
      <section class="route-controls" id="routeControls" hidden><label>Start at<select id="entrance"><% map.entrances.forEach(entry=>{ %><option value="<%= entry.id %>"><%= entry.name %></option><% }) %></select></label><button class="button full-button" id="buildRoute">Build my route</button></section>
      <section class="journey-progress" id="journeyProgress" hidden><div class="progress-copy"><b id="progressLabel">Ready to shop</b><span id="progressCount">0 of 0</span></div><div class="progress-track"><i id="progressBar"></i></div><p>At each stop, tell us whether you found the product. This helps the store correct stock and shelf locations.</p></section>
      <ol id="routeStops" class="route-stops"></ol>
      <section class="route-complete" id="routeComplete" hidden><span>✓</span><div><h3>Shopping route complete</h3><p>You helped improve this store’s product locations for the next shopper.</p></div></section>
    </aside>
    <section class="customer-floor"><div class="map-toolbar"><button type="button" data-customer-zoom-out>−</button><button type="button" data-customer-zoom-reset>100%</button><button type="button" data-customer-zoom-in>+</button></div><div class="map-canvas"><svg id="storeMap" viewBox="0 0 <%= supermarket.map_width %> <%= supermarket.map_height %>"><defs><pattern id="customerGrid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0L0 0 0 40" fill="none" stroke="#e4dbcf"/></pattern></defs><rect width="100%" height="100%" fill="url(#customerGrid)"/><% map.aisles.forEach(aisle=>{ %><g class="customer-aisle"><rect x="<%= aisle.x %>" y="<%= aisle.y %>" width="<%= aisle.width %>" height="<%= aisle.height %>" rx="8"/><text x="<%= Number(aisle.x)+Number(aisle.width)/2 %>" y="<%= Number(aisle.y)+Number(aisle.height)/2 %>"><%= aisle.code %></text><text class="map-side" x="<%= Number(aisle.x)+Number(aisle.width)/2 %>" y="<%= Number(aisle.y)-8 %>">FRONT</text><text class="map-side" x="<%= Number(aisle.x)+Number(aisle.width)/2 %>" y="<%= Number(aisle.y)+Number(aisle.height)+15 %>">BACK</text></g><% }) %><% map.entrances.forEach(entry=>{ %><circle class="entrance" cx="<%= entry.x %>" cy="<%= entry.y %>" r="12"/><text class="entrance-label" x="<%= Number(entry.x)+17 %>" y="<%= Number(entry.y)+4 %>"><%= entry.name %></text><% }) %><polyline id="routeLine" points=""/></svg></div></section>
  </div>
</main>
<%- include('partials/footer') %>
