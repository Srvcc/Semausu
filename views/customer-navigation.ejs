<%- include('partials/head') %>
<main class="customer-map-page" data-navigation data-slug="<%= supermarket.slug %>" data-csrf="<%= csrf %>">
  <div class="customer-heading"><div><p class="eyebrow">SHOPPING ROUTE</p><h1><%= supermarket.name %></h1><p><%= supermarket.address %></p></div><div class="privacy-note">No login required</div></div>
  <div class="customer-layout">
    <aside class="shopping-builder" data-shopping-panel>
      <section class="builder-step"><span class="step-number">1</span><div><h2>Build your shopping list</h2><p>Enter one item per line, then choose the exact products you want.</p></div></section>
      <textarea id="shoppingList" rows="6" placeholder="Milk&#10;Eggs&#10;Bread"></textarea>
      <button class="button full-button" id="matchList">Find matching products</button>
      <div id="matchResults" class="match-results" aria-live="polite"></div>
      <section class="selection-success" id="selectionSuccess" hidden><span>✓</span><div><h3>Products added successfully</h3><p>Add anything else above, or create your route now.</p></div></section>
      <section class="route-controls" id="routeControls" hidden>
        <div class="route-point-selects"><label>Start at<select id="entrance"><% map.entrances.forEach(entry=>{ %><option value="<%= entry.id %>"><%= entry.name %></option><% }) %></select></label><label>Finish at<select id="finish"><% map.entrances.forEach(entry=>{ %><option value="<%= entry.id %>"><%= entry.name %></option><% }) %></select></label></div>
        <button class="button full-button" id="buildRoute">Build my route</button>
      </section>
      <section class="journey-progress" id="journeyProgress" hidden><div class="progress-copy"><b id="progressLabel">Ready to shop</b><span id="progressCount">0 of 0</span></div><div class="progress-track"><i id="progressBar"></i></div><p id="nextInstruction">Follow the highlighted route to your next stop.</p></section>
      <ol id="routeStops" class="route-stops"></ol>
      <section class="route-complete" id="routeComplete" hidden><span>✓</span><div><h3>Shopping route complete</h3><p>You reached the finish point and helped improve this store’s locations.</p></div></section>
    </aside>
    <section class="customer-floor">
      <div class="map-toolbar"><button type="button" data-customer-zoom-out aria-label="Zoom out">−</button><button type="button" data-customer-zoom-reset>Fit</button><button type="button" data-customer-zoom-in aria-label="Zoom in">+</button><button type="button" data-focus-next>Next</button></div>
      <div class="map-canvas" data-map-canvas tabindex="0" aria-label="Interactive store map. Drag to pan and use the zoom controls."><svg id="storeMap" viewBox="0 0 <%= supermarket.map_width %> <%= supermarket.map_height %>"><defs><pattern id="customerGrid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0L0 0 0 40" fill="none" stroke="#e4dbcf"/></pattern></defs><rect width="100%" height="100%" fill="url(#customerGrid)"/><% map.aisles.forEach(aisle=>{ %><g class="customer-aisle fixture-<%= aisle.kind %>"><rect x="<%= aisle.x %>" y="<%= aisle.y %>" width="<%= aisle.width %>" height="<%= aisle.height %>" rx="8"/><text x="<%= Number(aisle.x)+Number(aisle.width)/2 %>" y="<%= Number(aisle.y)+Number(aisle.height)/2 %>"><%= aisle.code %></text><text class="map-side" x="<%= Number(aisle.x)+Number(aisle.width)/2 %>" y="<%= Number(aisle.y)-8 %>">FRONT</text><text class="map-side" x="<%= Number(aisle.x)+Number(aisle.width)/2 %>" y="<%= Number(aisle.y)+Number(aisle.height)+15 %>">BACK</text></g><% }) %><% map.entrances.forEach(entry=>{ %><circle class="entrance" cx="<%= entry.x %>" cy="<%= entry.y %>" r="12"/><text class="entrance-label" x="<%= Number(entry.x)+17 %>" y="<%= Number(entry.y)+4 %>"><%= entry.name %></text><% }) %><g id="routeHistory"></g><g id="routeFuture"></g><g id="routeActive"></g><g id="routeMarkers"></g></svg></div>
      <div class="mobile-next-card" id="mobileNextCard" hidden><span id="mobileStopNumber">1</span><div><small>NEXT STOP</small><b id="mobileStopName"></b><p id="mobileDirection"></p></div><button type="button" data-expand-journey>List</button></div>
    </section>
  </div>
</main>
<%- include('partials/footer') %>
