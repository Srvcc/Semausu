<%- include('partials/head') %><main class="auth-page"><form class="panel auth-card" method="post" action="/list-your-supermarket"><input type="hidden" name="_csrf" value="<%= csrf %>"><p class="eyebrow">SUPERMARKET OWNER</p><h1>Register your supermarket</h1><p>Create the owner account. You can invite managers and staff after verification.</p><% if(typeof error!=='undefined'){ %><p class="form-error"><%= error %></p><% } %><label>Your full name<input name="name" required></label><label>Work email<input type="email" name="email" required></label><label>Password<input type="password" name="password" required minlength="12"><small>12+ characters with uppercase, lowercase and a number</small></label><label>Supermarket name<input name="supermarketName" required></label><label>Address<input name="address"></label><label>Phone<input name="phone"></label><button class="button">Register and verify</button></form></main><%- include('partials/footer') %>
