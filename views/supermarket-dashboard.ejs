<%- include('partials/head') %>
<main><div class="pagehead"><div><p class="eyebrow">SUPERMARKET WORKSPACE</p><h1><%= supermarket.name %></h1><p>Manage products and their exact aisle, bay and shelf locations.</p></div><a class="button secondary" href="/supermarkets/<%= supermarket.slug %>">View customer map</a></div>
<div class="dashboard"><form class="panel" method="post" action="/supermarket/<%= supermarket.slug %>/products"><h2>Add product</h2><label>Name<input required name="name"></label><label>Category<input required name="category" value="General"></label><label>SKU<input name="sku"></label><label>Price<input required name="price" type="number" min="0" step="0.01"></label><label>Stock<input required name="stock" type="number" min="0" value="0"></label><label>Aisle<select name="aisleId"><% map.aisles.forEach(aisle => { %><option value="<%= aisle.id %>"><%= aisle.code %> · <%= aisle.name %></option><% }) %></select></label><div class="coordinates"><label>Bay<input name="bay" type="number" min="1" value="1"></label><label>Shelf<input name="shelf" value="Eye level"></label><label>Map X<input name="x" type="number" min="0" value="200"></label><label>Map Y<input name="y" type="number" min="0" value="200"></label></div><button class="button">Add product</button></form>
<section class="panel table-panel"><h2>Product catalogue</h2><table><thead><tr><th>Product</th><th>Location</th><th>Stock</th><th>Price</th><th></th></tr></thead><tbody><% map.products.forEach(product => { %><tr><td><b><%= product.name %></b><small><%= product.category %> · <%= product.sku %></small></td><td><%= product.aisle_code %>, bay <%= product.bay %>, <%= product.shelf %></td><td><%= product.stock %></td><td>R<%= product.price.toFixed(2) %></td><td><form method="post" action="/supermarket/<%= supermarket.slug %>/products/<%= product.id %>/delete"><button class="link-danger">Remove</button></form></td></tr><% }) %></tbody></table></section></div></main>
<%- include('partials/footer') %>
