<%- include('partials/head') %><main><div class="pagehead"><div><p class="eyebrow">SEMAUSU PLATFORM</p><h1>Platform control</h1><p>Manage supermarkets, accounts and support.</p></div></div><div class="stats"><article><b><%= stores.length %></b><span>Supermarkets</span></article><article><b><%= users.length %></b><span>Accounts</span></article><article><b><%= tickets.filter(x=>x.status!=='resolved').length %></b><span>Open tickets</span></article></div><% if(user.role==='platform_owner'){ %><section class="panel workspace-section"><h2>Invite platform employee</h2><form class="inline-form" method="post" action="/platform/invite"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="email" name="email" required placeholder="Work email"><button class="button">Send invitation</button></form></section><% } %><section class="panel workspace-section"><h2>Supermarkets</h2><div class="data-table"><% stores.forEach(store=>{ %><article><span><b><%= store.name %></b><small><%= store.address %> · <%= store.slug %></small></span><span><%= store.status %></span><% if(user.role==='platform_owner'){ %><form method="post" action="/platform/stores/<%= store.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= store.status==='active'?'suspended':'active' %>"><button class="link-button"><%= store.status==='active'?'Suspend':'Activate' %></button></form><% } %></article><% }) %></div></section><section class="panel workspace-section"><h2>Support tickets</h2><div class="data-table"><% tickets.forEach(ticket=>{ %><article><span><b><%= ticket.subject %></b><small><%= ticket.supermarket_name %> · <%= ticket.priority %> · <%= ticket.description %></small></span><form method="post" action="/platform/tickets/<%= ticket.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status"><option <%= ticket.status==='open'?'selected':'' %>>open</option><option <%= ticket.status==='in_progress'?'selected':'' %>>in_progress</option><option <%= ticket.status==='resolved'?'selected':'' %>>resolved</option></select><button class="link-button">Update</button></form></article><% }) %></div></section></main><%- include('partials/footer') %>
