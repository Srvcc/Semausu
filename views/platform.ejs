<%- include('partials/head') %>
<main class="platform-page" id="analytics">
  <div class="pagehead"><div><p class="eyebrow">SEMAUSU PLATFORM</p><h1>Platform pulse</h1><p>Growth, customer demand and operations in one place.</p></div><span class="insight-badge">Live network signals</span></div>
  <% const conversion=analytics.summary.searches?Math.round(analytics.summary.routes/analytics.summary.searches*100):0; const maxDaily=Math.max(1,...analytics.daily.map(x=>Math.max(x.searches,x.routes))); %>
  <div class="stats insight-stats"><article><b><%= analytics.summary.shoppers %></b><span>Shopping sessions</span></article><article><b><%= analytics.summary.searches %></b><span>Items searched</span></article><article><b><%= analytics.summary.routes %></b><span>Routes built</span></article><article><b><%= conversion %>%</b><span>Search-to-route rate</span></article></div>
  <div class="analytics-grid platform-analytics">
    <section class="panel chart-panel"><div class="panel-title"><div><p class="eyebrow">LAST 14 DAYS</p><h2>Customer activity</h2></div><div class="chart-key"><span class="search-key">Searches</span><span class="route-key">Routes</span></div></div><div class="bar-chart"><% if(!analytics.daily.length){ %><p class="empty-message">Activity will appear as customers use Semausu.</p><% } %><% analytics.daily.forEach(day=>{ %><div class="bar-day"><div class="bar-pair"><i class="bar-search" style="height:<%= Math.max(3,day.searches/maxDaily*100) %>%"></i><i class="bar-route" style="height:<%= Math.max(3,day.routes/maxDaily*100) %>%"></i></div><small><%= day.day.slice(5) %></small></div><% }) %></div></section>
    <section class="panel"><p class="eyebrow">NETWORK OPPORTUNITY</p><h2>Unmet demand</h2><p class="muted">Products customers searched for but could not confidently find.</p><div class="rank-list"><% if(!analytics.missing.length){ %><p class="empty-message">No missing-product signals yet.</p><% } %><% analytics.missing.forEach((item,index)=>{ %><article><span><b><%= index+1 %></b><%= item.query %></span><strong><%= item.searches %> · <%= item.stores %> stores</strong></article><% }) %></div></section>
  </div>
  <section class="panel workspace-section"><div class="panel-title"><div><p class="eyebrow">PERFORMANCE · SOUTH AFRICAN TIME</p><h2>Supermarket impact</h2></div><small>Compare adoption without customer personal data</small></div><div class="performance-table feedback-performance"><div class="table-head"><span>Supermarket</span><span>Shoppers</span><span>Searches</span><span>Routes</span><span>Found</span><span>Not found</span><span>Conversion</span></div><% analytics.storePerformance.forEach(store=>{ %><article><span><b><%= store.name %></b><small>/<%= store.slug %></small></span><span><%= store.shoppers %></span><span><%= store.searches %></span><span><%= store.routes %></span><span><%= store.found %></span><span><%= store.notFound %></span><strong><%= store.searches?Math.round(store.routes/store.searches*100):0 %>%</strong></article><% }) %></div></section>
  <div class="platform-grid" id="supermarkets">
    <% if(user.role==='platform_owner'){ %><section class="panel"><p class="eyebrow">PLATFORM TEAM</p><h2>Invite employee</h2><form class="stack-form" method="post" action="/platform/invite"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="email" name="email" required placeholder="Work email"><button class="button">Send invitation</button></form></section><% } %>
    <section class="panel"><p class="eyebrow">OPERATIONS</p><h2>Supermarkets</h2><div class="data-table compact-table"><% stores.forEach(store=>{ %><article><span><b><%= store.name %></b><small><%= store.address %> · <%= store.status %></small></span><% if(user.role==='platform_owner'){ %><form method="post" action="/platform/stores/<%= store.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= store.status==='active'?'suspended':'active' %>"><button class="link-button"><%= store.status==='active'?'Suspend':'Activate' %></button></form><% } %></article><% }) %></div></section>
  </div>
  <section class="panel workspace-section"><p class="eyebrow">SUPPORT</p><h2>Tickets</h2><div class="data-table"><% if(!tickets.length){ %><p class="empty-message">No support tickets.</p><% } %><% tickets.forEach(ticket=>{ %><article><span><b><%= ticket.subject %></b><small><%= ticket.supermarket_name %> · <%= ticket.priority %> · <%= ticket.description %></small></span><form method="post" action="/platform/tickets/<%= ticket.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status"><option <%= ticket.status==='open'?'selected':'' %>>open</option><option <%= ticket.status==='in_progress'?'selected':'' %>>in_progress</option><option <%= ticket.status==='resolved'?'selected':'' %>>resolved</option></select><button class="link-button">Update</button></form></article><% }) %></div></section>
</main>
<%- include('partials/footer') %>
