<%- include('partials/head') %><main class="auth-page"><form class="panel auth-card" method="post" action="<%= portal %>/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><p class="eyebrow"><%= platform?'PLATFORM TEAM':'SUPERMARKET TEAM' %></p><h1>Secure access</h1><p>This portal is for verified, authorized team members only.</p><% if(typeof error!=='undefined'){ %><p class="form-error"><%= error %></p><% } %><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" required></label><button class="button">Sign in</button><a href="<%= portal %>/forgot">Forgot password?</a></form></main><%- include('partials/footer') %>
