<%- include('partials/head') %><main class="auth-page"><% if(!invite){ %><section class="panel auth-card"><h1>Invitation expired</h1><p>Ask your administrator for a new invitation.</p></section><% }else{ %><form class="panel auth-card" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><p class="eyebrow">VERIFIED INVITATION</p><h1>Join as <%= invite.role.replace('_',' ') %></h1><p><%= invite.email %></p><% if(typeof error!=='undefined'){ %><p class="form-error"><%= error %></p><% } %><label>Full name<input name="name" required></label><label>Create password<input type="password" name="password" minlength="12" required></label><button class="button">Create verified account</button></form><% } %></main><%- include('partials/footer') %>
