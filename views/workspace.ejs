<%- include('partials/head') %><main><div class="pagehead"><div><p class="eyebrow">SUPERMARKET WORKSPACE</p><h1><%= store.name %></h1><p><%= store.address %> · Store status: <%= store.status %></p></div><a class="button secondary" href="/supermarkets/<%= store.slug %>">View customer map</a></div><nav class="tabs"><a href="#overview">Overview</a><a href="#products">Products</a><a href="#layout">Floor plan</a><% if(user.role!=='staff'){ %><a href="#team">Team</a><a href="#settings">Settings</a><% } %><a href="#support">Support</a></nav>
<section id="overview" class="workspace-section"><div class="stats"><article><b><%= products.length %></b><span>Products</span></article><article><b><%= aisles.length %></b><span>Mapped zones</span></article><article><b><%= team.filter(x=>x.status==='active').length %></b><span>Active team</span></article><article><b><%= products.filter(x=>x.stock<=5).length %></b><span>Low stock</span></article></div></section>
<section id="products" class="workspace-section panel"><h2>Product catalogue</h2><form class="form-grid" method="post" action="/workspace/products"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="name" placeholder="Product name" required><input name="category" placeholder="Category" value="General"><input name="sku" placeholder="SKU"><input name="barcode" placeholder="Barcode"><input type="number" name="price" min="0" step=".01" placeholder="Price" required><input type="number" name="stock" min="0" placeholder="Stock" required><select name="aisleId"><option value="">Unmapped</option><% aisles.forEach(x=>{ %><option value="<%= x.id %>"><%= x.code %> · <%= x.name %></option><% }) %></select><input type="number" name="bay" min="1" value="1"><input name="shelf" value="Eye level"><input type="number" name="x" min="0" value="0"><input type="number" name="y" min="0" value="0"><button class="button">Add product</button></form><div class="data-table"><% products.forEach(p=>{ %><article><span><b><%= p.name %></b><small><%= p.category %> · <%= p.aisle_code||'Unmapped' %> · Bay <%= p.bay %> · <%= p.shelf %></small></span><span>R<%= p.price.toFixed(2) %> · <%= p.stock %> in stock</span><% if(user.role!=='staff'){ %><form method="post" action="/workspace/products/<%= p.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-danger">Remove</button></form><% } %></article><% }) %></div></section>
<section id="layout" class="workspace-section split"><form class="panel" method="post" action="/workspace/aisles"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Add aisle or department</h2><label>Code<input name="code" required></label><label>Name<input name="name" required></label><label>Type<select name="kind"><option>aisle</option><option>department</option><option>service</option></select></label><div class="coordinates"><label>X<input type="number" name="x" value="100"></label><label>Y<input type="number" name="y" value="100"></label><label>Width<input type="number" name="width" value="100"></label><label>Height<input type="number" name="height" value="400"></label></div><button class="button">Add map zone</button></form><form class="panel" method="post" action="/workspace/entrances"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Add entrance</h2><label>Name<input name="name" required></label><div class="coordinates"><label>X<input type="number" name="x" value="100"></label><label>Y<input type="number" name="y" value="700"></label></div><button class="button">Add entrance</button></form></section>
<% if(user.role!=='staff'){ %><section id="team" class="workspace-section panel"><h2>Team access</h2><form class="inline-form" method="post" action="/workspace/team/invite"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="email" name="email" placeholder="Employee email" required><select name="role"><% if(user.role==='owner'){ %><option value="manager">Manager</option><% } %><option value="staff">Staff</option></select><button class="button">Send invitation</button></form><div class="data-table"><% team.forEach(member=>{ %><article><span><b><%= member.name %></b><small><%= member.email %> · <%= member.role %></small></span><span><%= member.status %></span><% if(member.role!=='owner'&&(user.role==='owner'||member.role==='staff')){ %><form method="post" action="/workspace/team/<%= member.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= member.status==='active'?'suspended':'active' %>"><button class="link-button"><%= member.status==='active'?'Suspend':'Activate' %></button></form><% } %></article><% }) %></div></section><section id="settings" class="workspace-section panel"><h2>Store settings</h2><form class="form-grid" method="post" action="/workspace/settings"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="name" value="<%= store.name %>" required><input name="address" value="<%= store.address %>"><input name="phone" value="<%= store.phone %>"><input type="number" name="mapWidth" value="<%= store.map_width %>"><input type="number" name="mapHeight" value="<%= store.map_height %>"><button class="button">Save settings</button></form></section><% } %>
<section id="support" class="workspace-section panel"><h2>Platform support</h2><form class="form-grid" method="post" action="/workspace/support"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="subject" placeholder="Subject" required><select name="priority"><option>normal</option><option>low</option><option>high</option><option>critical</option></select><textarea name="description" placeholder="Describe the issue" required></textarea><button class="button">Open ticket</button></form></section></main><%- include('partials/footer') %>
