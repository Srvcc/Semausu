<%- include('partials/head') %>
<main class="workspace-v2" data-workspace data-role="<%= user.role %>" data-csrf="<%= csrf %>">
  <div class="workspace-heading"><div><p class="eyebrow">SUPERMARKET WORKSPACE</p><h1><%= store.name %></h1><p><%= store.address %> · <%= store.status %></p></div><a class="button secondary" href="/supermarkets/<%= store.slug %>">Open customer view</a></div>
  <nav class="workspace-nav" aria-label="Workspace sections">
    <button data-workspace-tab="overview">Overview</button><button data-workspace-tab="analytics">Shopper insights</button><button data-workspace-tab="layout">Floor plan</button><button data-workspace-tab="products">Products</button><% if(user.role!=='staff'){ %><button data-workspace-tab="team">Team</button><button data-workspace-tab="settings">Settings</button><% } %><button data-workspace-tab="support">Support</button>
  </nav>

  <section class="workspace-view" data-workspace-view="overview">
    <div class="section-intro"><div><p class="eyebrow">TODAY</p><h2>Store overview</h2></div><p>Start with the floor plan, then place products on an aisle side and subsection.</p></div>
    <div class="stats"><article><b><%= products.length %></b><span>Products</span></article><article><b><%= aisles.length %></b><span>Aisles & zones</span></article><article><b><%= products.filter(product=>!product.aisle_id).length %></b><span>Need a location</span></article><article><b><%= products.filter(x=>x.stock<=5).length %></b><span>Low stock</span></article></div>
    <% const setupSteps=[{name:'Store boundary',done:Boolean(store.map_width&&store.map_height),href:'#settings',help:'Confirm the real floor dimensions'},{name:'Entrances & checkout',done:entrances.length>0&&checkouts.length>0,href:'#layout',help:'Add where shoppers start and pay'},{name:'Fixtures & corridors',done:aisles.length>0&&corridorEdges.length>0,href:'#layout',help:'Place fixtures and generate walking paths'},{name:'Product locations',done:products.some(p=>p.aisle_id),href:'#products',help:'Import and place the catalogue'},{name:'Customer test',done:analytics.summary.routes>0,href:'/supermarkets/'+store.slug,help:'Build one real test route'}],setupDone=setupSteps.filter(step=>step.done).length; %>
    <section class="setup-guide"><div class="setup-guide-head"><div><p class="eyebrow">GUIDED SETUP</p><h3><%= setupDone %> of <%= setupSteps.length %> ready</h3></div><div class="setup-meter"><i style="width:<%= setupDone/setupSteps.length*100 %>%"></i></div></div><div class="setup-cards"><% setupSteps.forEach((step,index)=>{ %><a class="setup-step <%= step.done?'is-done':'' %>" href="<%= step.href %>"><span><%= step.done?'✓':index+1 %></span><b><%= step.name %></b><small><%= step.help %></small></a><% }) %></div></section>
  </section>

  <section class="workspace-view" data-workspace-view="analytics" hidden>
    <div class="section-intro"><div><p class="eyebrow">DEMAND INTELLIGENCE</p><h2>Shopper insights</h2><p>Anonymous activity only—no customer accounts or personal details.</p></div><span class="insight-badge">Live store signals</span></div>
    <% const conversion=analytics.summary.searches?Math.round(analytics.summary.routes/analytics.summary.searches*100):0; const maxDaily=Math.max(1,...analytics.daily.map(x=>Math.max(x.searches,x.routes))); %>
    <div class="stats insight-stats"><article><b><%= analytics.summary.shoppers %></b><span>Shopping sessions</span></article><article><b><%= analytics.summary.searches %></b><span>Items searched</span></article><article><b><%= analytics.summary.routes %></b><span>Routes created</span></article><article><b><%= conversion %>%</b><span>Search-to-route rate</span></article></div>
    <div class="analytics-grid">
      <section class="panel chart-panel"><div class="panel-title"><div><p class="eyebrow">LAST 14 DAYS</p><h3>Searches and routes</h3></div><div class="chart-key"><span class="search-key">Searches</span><span class="route-key">Routes</span></div></div><div class="bar-chart"><% if(!analytics.daily.length){ %><p class="empty-message">Insights will appear after customers search.</p><% } %><% analytics.daily.forEach(day=>{ %><div class="bar-day" title="<%= day.day %>: <%= day.searches %> searches, <%= day.routes %> routes"><div class="bar-pair"><i class="bar-search" style="height:<%= Math.max(3,day.searches/maxDaily*100) %>%"></i><i class="bar-route" style="height:<%= Math.max(3,day.routes/maxDaily*100) %>%"></i></div><small><%= day.day.slice(5) %></small></div><% }) %></div></section>
      <section class="panel"><p class="eyebrow">STOCK OPPORTUNITIES</p><h3>Wanted but not found</h3><p class="muted">No confident match. Consider stocking it or improving catalogue names.</p><div class="rank-list"><% if(!analytics.missingSearches.length){ %><p class="empty-message">No missing demand yet.</p><% } %><% analytics.missingSearches.forEach((item,index)=>{ %><article><span><b><%= index+1 %></b><%= item.query %></span><strong><%= item.searches %> searches</strong></article><% }) %></div></section>
      <section class="panel"><p class="eyebrow">CUSTOMER INTENT</p><h3>Most searched products</h3><div class="rank-list"><% if(!analytics.topSearches.length){ %><p class="empty-message">No searches yet.</p><% } %><% analytics.topSearches.forEach((item,index)=>{ %><article><span><b><%= index+1 %></b><%= item.query %></span><strong><%= item.searches %></strong></article><% }) %></div></section>
      <section class="panel"><p class="eyebrow">BUSIEST TIMES · SOUTH AFRICA</p><h3>Plan staff around demand</h3><div class="hour-list"><% if(!analytics.hourly.length){ %><p class="empty-message">Peak times will appear here.</p><% } %><% analytics.hourly.forEach(item=>{ %><span><b><%= String(item.hour).padStart(2,'0') %>:00</b><small><%= item.searches %> searches</small></span><% }) %></div><div class="impact-callout"><b>Estimated shopper time saved</b><strong><%= analytics.summary.routes*5 %> minutes</strong><small>Estimate based on five minutes saved per route.</small></div><div class="find-rate"><span><b><%= analytics.summary.found %></b> products confirmed found</span><span><b><%= analytics.summary.notFound %></b> reported missing</span></div><div class="rank-list"><% analytics.notFoundProducts.forEach(item=>{ %><article><span><%= item.name %></span><strong><%= item.count %> not found</strong></article><% }) %></div></section>
    </div>
  </section>

  <section class="workspace-view floor-section" data-workspace-view="layout" hidden>
    <script type="application/json" id="fixtureKinds"><%- JSON.stringify(Object.fromEntries(aisles.map(item=>[item.id,item.kind]))).replace(/</g,'\\u003c') %></script><script type="application/json" id="aisleProductCounts"><%- JSON.stringify(Object.fromEntries(aisles.map(aisle=>[aisle.id,products.filter(product=>product.aisle_id===aisle.id).length]))).replace(/</g,'\\u003c') %></script>
    <div class="section-intro"><div><p class="eyebrow">VISUAL EDITOR</p><h2>Floor plan</h2><p>Fixtures block walking. Green lines are customer corridors; product stops connect from their exact aisle side and bay.</p></div><div class="floor-actions"><button class="tool-button" type="button" data-zoom-out>−</button><button class="tool-button" type="button" data-zoom-reset>100%</button><button class="tool-button" type="button" data-zoom-in>+</button><button class="button secondary" type="button" data-corridor-mode>Manage closures</button><% if(user.role!=='staff'){ %><button class="button secondary" type="button" data-expand-floor="width">Wider floor</button><button class="button secondary" type="button" data-expand-floor="height">Taller floor</button><% } %><button class="button" type="button" data-save-layout>Save floor plan</button></div></div>
    <div class="floor-editor-grid">
      <div class="floor-stage" data-floor-stage><svg data-floor-canvas viewBox="0 0 <%= store.map_width %> <%= store.map_height %>" aria-label="Editable supermarket floor plan">
        <defs><pattern id="floorGrid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="#e7ded2" stroke-width="1"/></pattern></defs><rect width="100%" height="100%" fill="url(#floorGrid)"/>
        <g class="corridor-network"><% corridorEdges.forEach(edge=>{ const from=corridorNodes.find(node=>node.id===edge.from_node_id),to=corridorNodes.find(node=>node.id===edge.to_node_id); if(from&&to){ %><line data-corridor-edge="<%= edge.id %>" data-status="<%= edge.status %>" x1="<%= from.x %>" y1="<%= from.y %>" x2="<%= to.x %>" y2="<%= to.y %>"/><% } }) %><% corridorNodes.forEach(node=>{ %><circle class="corridor-node" cx="<%= node.x %>" cy="<%= node.y %>" r="4"/><% }) %></g><g class="approach-points"><% approachPoints.forEach(point=>{ %><circle cx="<%= point.x %>" cy="<%= point.y %>" r="8"><title><%= point.side %> · Bay <%= point.bay %></title></circle><% }) %></g>
        <% checkouts.forEach(checkout=>{ %><g class="floor-checkout <%= checkout.status==='closed'?'is-closed':'' %>" data-checkout-id="<%= checkout.id %>" data-x="<%= checkout.x %>" data-y="<%= checkout.y %>" data-width="<%= checkout.width %>" data-height="<%= checkout.height %>" transform="translate(<%= checkout.x %> <%= checkout.y %>)"><rect class="checkout-body" width="<%= checkout.width %>" height="<%= checkout.height %>" rx="8"/><text x="<%= Number(checkout.width)/2 %>" y="<%= Number(checkout.height)/2 %>"><%= checkout.name %></text><circle class="resize-handle handle-nw" data-resize="nw" r="8"/><circle class="resize-handle handle-ne" data-resize="ne" r="8"/><circle class="resize-handle handle-se" data-resize="se" r="8"/><circle class="resize-handle handle-sw" data-resize="sw" r="8"/></g><% }) %>
        <% aisles.forEach(aisle=>{ const aisleSections=sections.filter(s=>s.aisle_id===aisle.id); %><g class="floor-aisle" tabindex="0" data-aisle-id="<%= aisle.id %>" data-x="<%= aisle.x %>" data-y="<%= aisle.y %>" data-width="<%= aisle.width %>" data-height="<%= aisle.height %>" transform="translate(<%= aisle.x %> <%= aisle.y %>)"><rect class="aisle-body" width="<%= aisle.width %>" height="<%= aisle.height %>" rx="8"/><text class="aisle-code" x="<%= aisle.width/2 %>" y="<%= aisle.height/2 %>"><%= aisle.code %></text><text class="side-label" x="<%= aisle.width/2 %>" y="-8">FRONT</text><text class="side-label" x="<%= aisle.width/2 %>" y="<%= aisle.height+15 %>">BACK</text><text class="side-label vertical" transform="translate(-9 <%= aisle.height/2 %>) rotate(-90)">LEFT</text><text class="side-label vertical" transform="translate(<%= aisle.width+12 %> <%= aisle.height/2 %>) rotate(90)">RIGHT</text><% aisleSections.forEach(section=>{ const horizontal=['front','back'].includes(section.side); const start=section.start_percent/100*(horizontal?aisle.width:aisle.height); const length=(section.end_percent-section.start_percent)/100*(horizontal?aisle.width:aisle.height); %><line class="section-line side-<%= section.side %>" x1="<%= horizontal?start:(section.side==='left'?-3:aisle.width+3) %>" y1="<%= horizontal?(section.side==='front'?-3:aisle.height+3):start %>" x2="<%= horizontal?start+length:(section.side==='left'?-3:aisle.width+3) %>" y2="<%= horizontal?(section.side==='front'?-3:aisle.height+3):start+length %>"/><% }) %><circle class="resize-handle" cx="<%= aisle.width %>" cy="<%= aisle.height %>" r="9"/></g><% }) %>
        <% sections.forEach(section=>{ const aisle=aisles.find(a=>a.id===section.aisle_id); if(!aisle)return; const horizontal=['front','back'].includes(section.side); const axis=(Number(section.start_percent)+Number(section.end_percent))/200*(horizontal?Number(aisle.width):Number(aisle.height)); const labelX=horizontal?Number(aisle.x)+axis:Number(aisle.x)+(section.side==='left'?-18:Number(aisle.width)+18); const labelY=horizontal?Number(aisle.y)+(section.side==='front'?-18:Number(aisle.height)+28):Number(aisle.y)+axis; %><text class="floor-section-label" x="<%= labelX %>" y="<%= labelY %>"><%= section.name %></text><% }) %>
        <% entrances.forEach(entry=>{ %><g class="floor-entrance" data-entrance-id="<%= entry.id %>" data-x="<%= entry.x %>" data-y="<%= entry.y %>" transform="translate(<%= entry.x %> <%= entry.y %>)"><circle cx="0" cy="0" r="13"/><text x="18" y="5"><%= entry.name %></text></g><% }) %>
      </svg><div class="floor-empty <%= aisles.length?'is-hidden':'' %>">Add your first aisle to begin the floor plan.</div></div>
      <aside class="floor-sidebar">
        <section class="editor-card selected-card"><h3>Selected aisle</h3><p data-selected-empty>Select an aisle on the map.</p><div data-selected-fields hidden><strong data-selected-name></strong><div class="mini-grid"><label>X<input data-field="x" type="number" min="0"></label><label>Y<input data-field="y" type="number" min="0"></label><label>Width<input data-field="width" type="number" min="60"></label><label>Height<input data-field="height" type="number" min="60"></label></div><% if(user.role!=='staff'){ %><form method="post" data-delete-aisle onsubmit="return confirm('Remove this aisle? Its products will become unmapped.')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger-button">Delete selected aisle</button></form><% } %></div></section>
        <% if(user.role!=='staff'){ %><form class="editor-card" method="post" action="/workspace/aisles"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Add aisle</h3><div class="mini-grid"><label>Code<input name="code" placeholder="A1" required></label><label>Name<input name="name" placeholder="Dairy" required></label><label>Width<input type="number" name="width" value="180" min="60" required></label><label>Height<input type="number" name="height" value="360" min="60" required></label></div><label>Type<select name="kind"><option>aisle</option><option>department</option><option>service</option></select></label><button class="button">Add to floor</button></form>
        <form class="editor-card" method="post" data-section-form><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Cut a named section</h3><p class="muted">Mark the percentage of one aisle side occupied by this section.</p><label>Aisle<select name="aisleId" data-section-aisle required><option value="">Choose aisle</option><% aisles.forEach(a=>{ %><option value="<%= a.id %>"><%= a.code %> · <%= a.name %></option><% }) %></select></label><label>Section name<input name="name" placeholder="Long-life milk" required></label><label>Side<select name="side"><option>front</option><option>back</option><option>left</option><option>right</option></select></label><div class="mini-grid"><label>Starts at %<input name="startPercent" type="number" value="0" min="0" max="99"></label><label>Ends at %<input name="endPercent" type="number" value="100" min="1" max="100"></label></div><button class="button secondary">Cut section</button><div class="manage-list"><% sections.forEach(section=>{ const aisle=aisles.find(x=>x.id===section.aisle_id); %><div><span><b><%= aisle?.code %> · <%= section.name %></b><small><%= section.side %> · <%= section.start_percent %>–<%= section.end_percent %>%</small></span><form method="post" action="/workspace/sections/<%= section.id %>/delete" onsubmit="return confirm('Delete this section?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-danger" title="Delete section">×</button></form></div><% }) %></div></form>
        <form class="editor-card" method="post" action="/workspace/entrances"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Entrances</h3><label>Name<input name="name" placeholder="Main entrance" required></label><div class="mini-grid"><label>X<input type="number" name="x" value="80"></label><label>Y<input type="number" name="y" value="680"></label></div><button class="button secondary">Add entrance</button><div class="manage-list"><% entrances.forEach(entry=>{ %><div><span><b><%= entry.name %></b><small>X <%= entry.x %> · Y <%= entry.y %></small></span><form method="post" action="/workspace/entrances/<%= entry.id %>/delete" onsubmit="return confirm('Delete this entrance?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-danger" title="Delete entrance">×</button></form></div><% }) %></div></form>
        <form class="editor-card" method="post" action="/workspace/checkouts"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Checkout zone</h3><label>Name<input name="name" placeholder="Main tills" required></label><label>Type<select name="checkoutType"><option value="traditional">Traditional tills</option><option value="express">Express</option><option value="self_service">Self-checkout</option><option value="customer_service">Customer service</option></select></label><div class="mini-grid"><label>X<input type="number" name="x" value="300"></label><label>Y<input type="number" name="y" value="650"></label><label>Width<input type="number" name="width" value="220"></label><label>Height<input type="number" name="height" value="70"></label></div><label>Customer approaches from<select name="approachSide"><option>front</option><option>back</option><option>left</option><option>right</option></select></label><button class="button secondary">Add checkout</button><div class="manage-list"><% checkouts.forEach(checkout=>{ %><div><span><b><%= checkout.name %></b><small><%= checkout.checkout_type %> · <%= checkout.status %></small></span><form method="post" action="/workspace/checkouts/<%= checkout.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= checkout.status==='open'?'closed':'open' %>"><button class="link-button"><%= checkout.status==='open'?'Close':'Open' %></button></form><form method="post" action="/workspace/checkouts/<%= checkout.id %>/delete" onsubmit="return confirm('Delete this checkout?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-danger">×</button></form></div><% }) %></div></form>
        <form class="editor-card corridor-card" method="post" action="/workspace/corridors/generate"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Walking network</h3><p class="muted"><b><%= corridorEdges.length %></b> paths, <b><%= corridorEdges.filter(edge=>edge.status==='closed').length %></b> closed.</p><p class="muted">Regenerate after moving fixtures, entrances or checkout zones.</p><button class="button full-button">Generate safe corridors</button><small>Use Manage closures, then tap a green path to close or reopen it.</small></form><% } %>
      </aside>
    </div>
  </section>

  <section class="workspace-view" data-workspace-view="products" hidden>
    <div class="section-intro"><div><p class="eyebrow">CATALOGUE</p><h2>Products</h2><p>Upload thousands from Excel, then assign groups to their real shelf locations.</p></div></div>
    <% const unmappedProducts=products.filter(product=>!product.aisle_id); if(unmappedProducts.length){ %><section class="panel unmapped-products"><p class="eyebrow">NEEDS ATTENTION</p><h3><%= unmappedProducts.length %> product<%= unmappedProducts.length===1?' needs':'s need' %> a shelf location</h3><p>These products are preserved but hidden from customer search and routing until staff assign a valid aisle.</p><div class="unmapped-name-list"><% unmappedProducts.slice(0,12).forEach(product=>{ %><span><%= product.name %></span><% }) %><% if(unmappedProducts.length>12){ %><span>+ <%= unmappedProducts.length-12 %> more</span><% } %></div></section><% } %>
    <% if(locationTasks.length){ %><section class="panel location-tasks"><p class="eyebrow">LOCATION CHECKS</p><h3>Customers reported these locations as wrong</h3><div class="manage-list"><% locationTasks.forEach(task=>{ %><div><span><b><%= task.product_name||'Unknown product' %></b><small>Reported <%= new Date(task.created_at).toLocaleString('en-ZA',{timeZone:'Africa/Johannesburg'}) %></small></span><form method="post" action="/workspace/location-tasks/<%= task.id %>/resolve"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary">Mark checked</button></form></div><% }) %></div></section><% } %>
    <% if(user.role!=='staff'){ %><div class="catalog-tools"><details class="add-product-card import-card" data-importer><summary>Import CSV catalogue</summary><div class="import-steps"><div><span>1</span><b>Choose CSV</b><small>Export from Excel or your POS.</small></div><div><span>2</span><b>Review preview</b><small>We recognize common column names.</small></div><div><span>3</span><b>Import safely</b><small>Barcode/SKU matches are updated.</small></div></div><div class="import-actions"><input type="file" accept=".csv,text/csv" data-import-file><a class="button secondary" href="/workspace/products/import-template">Download template</a></div><p class="muted" data-import-status>Select a CSV file to preview it. Nothing is saved until you confirm.</p><div class="import-preview" data-import-preview></div><button class="button" type="button" data-import-confirm hidden>Import products</button></details>
    <details class="add-product-card"><summary>Add one product manually</summary><form class="product-form" method="post" action="/workspace/products"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Product name<input name="name" required></label><label>Category<input name="category" value="General"></label><label>SKU<input name="sku"></label><label>Barcode<input name="barcode"></label><label>Price<input type="number" name="price" min="0" step=".01" required></label><label>Stock<input type="number" name="stock" min="0" required></label><label>Aisle<select name="aisleId" data-product-aisle><option value="">Unmapped</option><% aisles.forEach(a=>{ %><option value="<%= a.id %>"><%= a.code %> · <%= a.name %></option><% }) %></select></label><label>Side<select name="aisleSide" data-product-side><option>front</option><option>back</option><option>left</option><option>right</option></select></label><label>Subsection<select name="sectionId" data-product-section><option value="">No subsection</option><% sections.forEach(s=>{ %><option value="<%= s.id %>" data-aisle="<%= s.aisle_id %>" data-side="<%= s.side %>"><%= s.name %></option><% }) %></select></label><label>Bay<input type="number" name="bay" min="1" value="1"></label><label>Shelf<input name="shelf" value="Eye level"></label><button class="button">Save product</button></form></details></div>
    <% if(products.length&&aisles.length){ %><form id="bulkLocationForm" class="bulk-location" method="post" action="/workspace/products/bulk-location"><input type="hidden" name="_csrf" value="<%= csrf %>"><b>Assign selected products</b><select name="aisleId" data-bulk-aisle required><option value="">Choose aisle</option><% aisles.forEach(a=>{ %><option value="<%= a.id %>"><%= a.code %> · <%= a.name %></option><% }) %></select><select name="aisleSide" data-bulk-side><option>front</option><option>back</option><option>left</option><option>right</option></select><select name="sectionId" data-bulk-section><option value="">No section</option><% sections.forEach(s=>{ %><option value="<%= s.id %>" data-aisle="<%= s.aisle_id %>" data-side="<%= s.side %>"><%= s.name %></option><% }) %></select><button class="button">Assign location</button></form><% } %><% } %>
    <div class="product-list grouped-products"><% if(!products.length){ %><p class="empty-message">No products yet. Import a catalogue or add the first product.</p><% } %><% [...new Set(products.map(p=>p.category||'General'))].sort().forEach(category=>{ const categoryProducts=products.filter(p=>(p.category||'General')===category); %><details class="product-category"><summary><span><b><%= category %></b><small><%= categoryProducts.length %> product<%= categoryProducts.length===1?'':'s' %></small></span><i>Open</i></summary><div class="category-products"><% categoryProducts.forEach(p=>{ const section=sections.find(s=>s.id===p.section_id); %><article><% if(user.role!=='staff'){ %><input class="product-select" form="bulkLocationForm" type="checkbox" name="productIds" value="<%= p.id %>" aria-label="Select <%= p.name %>"><% } %><div><b><%= p.name %></b><span><%= p.aisle_code||'Unmapped' %> · <%= p.aisle_side %></span></div><p>Bay <%= p.bay %> · <%= p.shelf %><%= section?' · '+section.name:'' %></p><strong>R<%= Number(p.price).toFixed(2) %><small><%= p.stock %> in stock</small></strong><% if(user.role!=='staff'){ %><form method="post" action="/workspace/products/<%= p.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-danger">Remove</button></form><% } %></article><% }) %></div></details><% }) %></div>
  </section>

  <% if(user.role!=='staff'){ %><section class="workspace-view" data-workspace-view="team" hidden><div class="section-intro"><div><p class="eyebrow">ACCESS</p><h2>Team</h2></div></div><div class="panel"><form class="inline-form" method="post" action="/workspace/team/invite"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="email" name="email" placeholder="Employee email" required><select name="role"><% if(user.role==='owner'){ %><option value="manager">Manager</option><% } %><option value="staff">Staff</option></select><button class="button">Send invitation</button></form><div class="data-table"><% team.forEach(member=>{ %><article><span><b><%= member.name %></b><small><%= member.email %> · <%= member.role %></small></span><span><%= member.status %></span><% if(member.role!=='owner'&&(user.role==='owner'||member.role==='staff')){ %><form method="post" action="/workspace/team/<%= member.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= member.status==='active'?'suspended':'active' %>"><button class="link-button"><%= member.status==='active'?'Suspend':'Activate' %></button></form><% } %></article><% }) %></div></div></section>
  <section class="workspace-view" data-workspace-view="settings" hidden><div class="section-intro"><div><p class="eyebrow">STORE</p><h2>Settings</h2></div></div><form class="panel form-grid" method="post" action="/workspace/settings"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Name<input name="name" value="<%= store.name %>" required></label><label>Address<input name="address" value="<%= store.address %>"></label><label>Phone<input name="phone" value="<%= store.phone %>"></label><label>Map width<input type="number" name="mapWidth" value="<%= store.map_width %>"></label><label>Map height<input type="number" name="mapHeight" value="<%= store.map_height %>"></label><button class="button">Save settings</button></form></section><% } %>
  <section class="workspace-view" data-workspace-view="support" hidden><div class="section-intro"><div><p class="eyebrow">HELP</p><h2>Platform support</h2></div></div><form class="panel product-form" method="post" action="/workspace/support"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Subject<input name="subject" required></label><label>Priority<select name="priority"><option>normal</option><option>low</option><option>high</option><option>critical</option></select></label><label class="wide">Description<textarea name="description" required></textarea></label><button class="button">Open ticket</button></form></section>
</main>
<%- include('partials/footer') %>
