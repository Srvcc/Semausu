<%- include('partials/head') %>
<main class="workspace-v2" data-workspace data-csrf="<%= csrf %>">
  <div class="workspace-heading"><div><p class="eyebrow">SUPERMARKET WORKSPACE</p><h1><%= store.name %></h1><p><%= store.address %> · <%= store.status %></p></div><a class="button secondary" href="/supermarkets/<%= store.slug %>">Open customer view</a></div>
  <nav class="workspace-nav" aria-label="Workspace sections">
    <button data-workspace-tab="overview">Overview</button><button data-workspace-tab="layout">Floor plan</button><button data-workspace-tab="products">Products</button><% if(user.role!=='staff'){ %><button data-workspace-tab="team">Team</button><button data-workspace-tab="settings">Settings</button><% } %><button data-workspace-tab="support">Support</button>
  </nav>

  <section class="workspace-view" data-workspace-view="overview">
    <div class="section-intro"><div><p class="eyebrow">TODAY</p><h2>Store overview</h2></div><p>Start with the floor plan, then place products on an aisle side and subsection.</p></div>
    <div class="stats"><article><b><%= products.length %></b><span>Products</span></article><article><b><%= aisles.length %></b><span>Aisles & zones</span></article><article><b><%= sections.length %></b><span>Subsections</span></article><article><b><%= products.filter(x=>x.stock<=5).length %></b><span>Low stock</span></article></div>
    <div class="next-steps"><h3>Recommended setup order</h3><ol><li>Draw and position aisles</li><li>Add named subsections to each side</li><li>Add products and choose their exact side</li><li>Test the customer route</li></ol></div>
  </section>

  <section class="workspace-view floor-section" data-workspace-view="layout" hidden>
    <div class="section-intro"><div><p class="eyebrow">VISUAL EDITOR</p><h2>Floor plan</h2><p>Drag aisles, resize from the red handle, zoom, then save.</p></div><div class="floor-actions"><button class="tool-button" type="button" data-zoom-out>−</button><button class="tool-button" type="button" data-zoom-reset>100%</button><button class="tool-button" type="button" data-zoom-in>+</button><button class="button" type="button" data-save-layout>Save floor plan</button></div></div>
    <div class="floor-editor-grid">
      <div class="floor-stage" data-floor-stage><svg data-floor-canvas viewBox="0 0 <%= store.map_width %> <%= store.map_height %>" aria-label="Editable supermarket floor plan">
        <defs><pattern id="floorGrid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="#e7ded2" stroke-width="1"/></pattern></defs><rect width="100%" height="100%" fill="url(#floorGrid)"/>
        <% aisles.forEach(aisle=>{ const aisleSections=sections.filter(s=>s.aisle_id===aisle.id); %><g class="floor-aisle" tabindex="0" data-aisle-id="<%= aisle.id %>" data-x="<%= aisle.x %>" data-y="<%= aisle.y %>" data-width="<%= aisle.width %>" data-height="<%= aisle.height %>" transform="translate(<%= aisle.x %> <%= aisle.y %>)"><rect class="aisle-body" width="<%= aisle.width %>" height="<%= aisle.height %>" rx="8"/><text class="aisle-code" x="<%= aisle.width/2 %>" y="<%= aisle.height/2 %>"><%= aisle.code %></text><text class="side-label" x="<%= aisle.width/2 %>" y="-8">FRONT</text><text class="side-label" x="<%= aisle.width/2 %>" y="<%= aisle.height+15 %>">BACK</text><text class="side-label vertical" transform="translate(-9 <%= aisle.height/2 %>) rotate(-90)">LEFT</text><text class="side-label vertical" transform="translate(<%= aisle.width+12 %> <%= aisle.height/2 %>) rotate(90)">RIGHT</text><% aisleSections.forEach(section=>{ const horizontal=['front','back'].includes(section.side); const start=section.start_percent/100*(horizontal?aisle.width:aisle.height); const length=(section.end_percent-section.start_percent)/100*(horizontal?aisle.width:aisle.height); %><line class="section-line side-<%= section.side %>" x1="<%= horizontal?start:(section.side==='left'?-3:aisle.width+3) %>" y1="<%= horizontal?(section.side==='front'?-3:aisle.height+3):start %>" x2="<%= horizontal?start+length:(section.side==='left'?-3:aisle.width+3) %>" y2="<%= horizontal?(section.side==='front'?-3:aisle.height+3):start+length %>"/><% }) %><circle class="resize-handle" cx="<%= aisle.width %>" cy="<%= aisle.height %>" r="9"/></g><% }) %>
        <% entrances.forEach(entry=>{ %><g class="floor-entrance"><circle cx="<%= entry.x %>" cy="<%= entry.y %>" r="13"/><text x="<%= entry.x+18 %>" y="<%= entry.y+5 %>"><%= entry.name %></text></g><% }) %>
      </svg><div class="floor-empty <%= aisles.length?'is-hidden':'' %>">Add your first aisle to begin the floor plan.</div></div>
      <aside class="floor-sidebar">
        <section class="editor-card selected-card"><h3>Selected aisle</h3><p data-selected-empty>Select an aisle on the map.</p><div data-selected-fields hidden><strong data-selected-name></strong><div class="mini-grid"><label>X<input data-field="x" type="number" min="0"></label><label>Y<input data-field="y" type="number" min="0"></label><label>Width<input data-field="width" type="number" min="60"></label><label>Height<input data-field="height" type="number" min="60"></label></div></div></section>
        <% if(user.role!=='staff'){ %><form class="editor-card" method="post" action="/workspace/aisles"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Add aisle</h3><div class="mini-grid"><label>Code<input name="code" placeholder="A1" required></label><label>Name<input name="name" placeholder="Dairy" required></label><label>Width<input type="number" name="width" value="180" min="60" required></label><label>Height<input type="number" name="height" value="360" min="60" required></label></div><label>Type<select name="kind"><option>aisle</option><option>department</option><option>service</option></select></label><button class="button">Add to floor</button></form>
        <form class="editor-card" method="post" data-section-form><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Add subsection</h3><label>Aisle<select name="aisleId" data-section-aisle required><option value="">Choose aisle</option><% aisles.forEach(a=>{ %><option value="<%= a.id %>"><%= a.code %> · <%= a.name %></option><% }) %></select></label><label>Name<input name="name" placeholder="Long-life milk" required></label><label>Side<select name="side"><option>front</option><option>back</option><option>left</option><option>right</option></select></label><div class="mini-grid"><label>Starts at %<input name="startPercent" type="number" value="0" min="0" max="99"></label><label>Ends at %<input name="endPercent" type="number" value="100" min="1" max="100"></label></div><button class="button secondary">Add subsection</button></form>
        <form class="editor-card" method="post" action="/workspace/entrances"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Add entrance</h3><label>Name<input name="name" placeholder="Main entrance" required></label><div class="mini-grid"><label>X<input type="number" name="x" value="80"></label><label>Y<input type="number" name="y" value="680"></label></div><button class="button secondary">Add entrance</button></form><% } %>
      </aside>
    </div>
  </section>

  <section class="workspace-view" data-workspace-view="products" hidden>
    <div class="section-intro"><div><p class="eyebrow">CATALOGUE</p><h2>Products</h2><p>Place each product on an aisle, one of its four sides, and an optional subsection.</p></div></div>
    <details class="add-product-card"><summary>Add a product</summary><form class="product-form" method="post" action="/workspace/products"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Product name<input name="name" required></label><label>Category<input name="category" value="General"></label><label>SKU<input name="sku"></label><label>Barcode<input name="barcode"></label><label>Price<input type="number" name="price" min="0" step=".01" required></label><label>Stock<input type="number" name="stock" min="0" required></label><label>Aisle<select name="aisleId" data-product-aisle><option value="">Unmapped</option><% aisles.forEach(a=>{ %><option value="<%= a.id %>"><%= a.code %> · <%= a.name %></option><% }) %></select></label><label>Side<select name="aisleSide" data-product-side><option>front</option><option>back</option><option>left</option><option>right</option></select></label><label>Subsection<select name="sectionId" data-product-section><option value="">No subsection</option><% sections.forEach(s=>{ %><option value="<%= s.id %>" data-aisle="<%= s.aisle_id %>" data-side="<%= s.side %>"><%= s.name %></option><% }) %></select></label><label>Bay<input type="number" name="bay" min="1" value="1"></label><label>Shelf<input name="shelf" value="Eye level"></label><button class="button">Save product</button></form></details>
    <div class="product-list"><% if(!products.length){ %><p class="empty-message">No products yet.</p><% } %><% products.forEach(p=>{ const section=sections.find(s=>s.id===p.section_id); %><article><div><b><%= p.name %></b><span><%= p.category %></span></div><p><%= p.aisle_code||'Unmapped' %> · <%= p.aisle_side %><%= section?' · '+section.name:'' %><br><small>Bay <%= p.bay %> · <%= p.shelf %></small></p><strong>R<%= Number(p.price).toFixed(2) %><small><%= p.stock %> in stock</small></strong><% if(user.role!=='staff'){ %><form method="post" action="/workspace/products/<%= p.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-danger">Remove</button></form><% } %></article><% }) %></div>
  </section>

  <% if(user.role!=='staff'){ %><section class="workspace-view" data-workspace-view="team" hidden><div class="section-intro"><div><p class="eyebrow">ACCESS</p><h2>Team</h2></div></div><div class="panel"><form class="inline-form" method="post" action="/workspace/team/invite"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="email" name="email" placeholder="Employee email" required><select name="role"><% if(user.role==='owner'){ %><option value="manager">Manager</option><% } %><option value="staff">Staff</option></select><button class="button">Send invitation</button></form><div class="data-table"><% team.forEach(member=>{ %><article><span><b><%= member.name %></b><small><%= member.email %> · <%= member.role %></small></span><span><%= member.status %></span><% if(member.role!=='owner'&&(user.role==='owner'||member.role==='staff')){ %><form method="post" action="/workspace/team/<%= member.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= member.status==='active'?'suspended':'active' %>"><button class="link-button"><%= member.status==='active'?'Suspend':'Activate' %></button></form><% } %></article><% }) %></div></div></section>
  <section class="workspace-view" data-workspace-view="settings" hidden><div class="section-intro"><div><p class="eyebrow">STORE</p><h2>Settings</h2></div></div><form class="panel form-grid" method="post" action="/workspace/settings"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Name<input name="name" value="<%= store.name %>" required></label><label>Address<input name="address" value="<%= store.address %>"></label><label>Phone<input name="phone" value="<%= store.phone %>"></label><label>Map width<input type="number" name="mapWidth" value="<%= store.map_width %>"></label><label>Map height<input type="number" name="mapHeight" value="<%= store.map_height %>"></label><button class="button">Save settings</button></form></section><% } %>
  <section class="workspace-view" data-workspace-view="support" hidden><div class="section-intro"><div><p class="eyebrow">HELP</p><h2>Platform support</h2></div></div><form class="panel product-form" method="post" action="/workspace/support"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Subject<input name="subject" required></label><label>Priority<select name="priority"><option>normal</option><option>low</option><option>high</option><option>critical</option></select></label><label class="wide">Description<textarea name="description" required></textarea></label><button class="button">Open ticket</button></form></section>
</main>
<%- include('partials/footer') %>
