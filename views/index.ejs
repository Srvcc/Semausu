<%- include('partials/head') %><main class="home"><section class="hero"><p class="eyebrow">INDOOR SUPERMARKET NAVIGATION</p><h1>Find everything.<br><em>Without searching.</em></h1><p>Choose a supermarket, build your shopping list, and follow the shortest route to each product's aisle, bay and shelf.</p></section><section><h2>Choose a supermarket</h2><div class="cards"><% supermarkets.forEach(supermarket => { %><a class="card" href="/supermarkets/<%= supermarket.slug %>"><span>OPEN STORE MAP</span><h3><%= supermarket.name %></h3><p><%= supermarket.address %></p></a><% }) %></div></section></main><%- include('partials/footer') %>
