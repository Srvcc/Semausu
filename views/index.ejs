<%- include('partials/head') %><main class="home"><section class="hero"><p class="eyebrow">ANONYMOUS IN-STORE NAVIGATION</p><h1>Find everything.<br><em>Without searching.</em></h1><p>Choose a supermarket, build your shopping list, and follow the shortest route to every aisle, bay and shelf. Customers never need an account.</p><a class="button" href="#stores">Choose a supermarket</a> <a class="button secondary" href="/list-your-supermarket">List your supermarket</a></section><section id="stores"><h2>Available supermarkets</h2><div class="cards"><% if(!supermarkets.length){ %><article class="card"><h3>No supermarkets are live yet</h3><p>Verified supermarkets will appear here.</p></article><% } %><% supermarkets.forEach(supermarket=>{ %><a class="card" href="/supermarkets/<%= supermarket.slug %>"><span>OPEN STORE MAP</span><h3><%= supermarket.name %></h3><p><%= supermarket.address %></p></a><% }) %></div></section></main><%- include('partials/footer') %>
