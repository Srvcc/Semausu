<%- include('partials/head') %><main class="auth-page"><form class="panel auth-card" method="post" action="/verify"><input type="hidden" name="_csrf" value="<%= csrf %>"><p class="eyebrow">EMAIL VERIFICATION</p><h1>Enter your code</h1><% if(typeof error!=='undefined'){ %><p class="form-error"><%= error %></p><% } %><label>Email<input type="email" name="email" value="<%= email %>" required></label><label>Six-digit code<input name="code" inputmode="numeric" maxlength="6" required></label><% if(devCode){ %><p class="notice">Development code: <b><%= devCode %></b></p><% } %><button class="button">Verify account</button></form></main><%- include('partials/footer') %>
