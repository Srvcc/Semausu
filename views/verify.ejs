<%- include('partials/head') %><main class="auth-page"><section class="panel auth-card"><form method="post" action="/verify"><input type="hidden" name="_csrf" value="<%= csrf %>"><p class="eyebrow">EMAIL VERIFICATION</p><h1>Enter your code</h1><% if(typeof error!=='undefined'&&error){ %><p class="form-error"><%= error %></p><% } %><% if(typeof notice!=='undefined'&&notice){ %><p class="notice"><%= notice %></p><% } %><label>Email<input type="email" name="email" value="<%= email %>" required></label><label>Six-digit code<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required></label><% if(devCode){ %><p class="notice">Development code: <b><%= devCode %></b></p><% } %><button class="button" data-loading-text="Verifying…">Verify account</button></form><form class="resend-form" method="post" action="/verify/resend"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="email" value="<%= email %>"><p>Didn’t receive the email? Check spam first.</p><button class="button secondary" data-loading-text="Sending…">Send a new code</button></form></section></main><%- include('partials/footer') %>
